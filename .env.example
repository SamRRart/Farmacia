# Configuracion para PostgreSQL (Local o Supabase)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=contraseña_local
DB_SSLMODE=prefer

# Opcional: Conexion directa mediante URI completa
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Opcional: SMTP para notificar por correo las ordenes de restock y facturas
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=Farmacia CUCEI <notificaciones@farmaciacucei.com>
